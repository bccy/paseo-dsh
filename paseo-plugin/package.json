      "optional": true
    }
  },
  "devDependencies": {
    "@getpaseo/client": "0.16.0-beta.1",
    "@getpaseo/plugin": "0.16.0-beta.1",
    "@getpaseo/protocol": "0.16.0-beta.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "react-native": "^0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
