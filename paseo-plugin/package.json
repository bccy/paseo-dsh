{
  "name": "paseo-dsh",
  "version": "0.2.16",
  "description": "DeepSeek Harness (dsh) as a native Paseo provider: question cards, plan mode, thinking levels, steering, images, a slash menu, permissions and presets, rewind, goal/team/background pills, and session usage. 把 DeepSeek Harness 接成 Paseo 原生 provider：提问卡片、计划模式、思考档位、插话、图片、斜杠菜单、权限与预设、撤回、目标/团队/后台任务 pill、会话用量。",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "provider"
  ],
  "author": "bccy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bccy/paseo-dsh.git",
    "directory": "paseo-plugin"
  },
  "homepage": "https://github.com/bccy/paseo-dsh#readme",
  "bugs": "https://github.com/bccy/paseo-dsh/issues",
  "bin": {
    "paseo-dsh": "bin/paseo-dsh.mjs"
  },
  "files": [
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.tsx",
    "server/",
    "client/",
    "shared/",
    "lib/",
    "bin/",
    "icon.svg",
    "README.md",
    "OVERVIEW.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-bridge-assets.mjs",
    "prepack": "node scripts/generate-bridge-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@getpaseo/plugin": ">=0.16.0-beta.1"
  },
  "peerDependenciesMeta": {
